# Copy this file to .env and adjust values as needed. Never commit real secrets.

# --- App ---
ENVIRONMENT=development
APP_NAME="Intelligent Document Extraction Platform"

# --- Database ---
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./documents.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@host:5432/documentdb

# --- File handling ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
MAX_PAGES=3

# --- OCR ---
OCR_LANGUAGE=eng
# Only needed if Tesseract is not on PATH (Windows default shown):
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MIN_TEXT_CHARS=30
PDF_RENDER_DPI=300

# --- Optional LLM extraction (disabled unless LLM_PROVIDER is set to "anthropic") ---
# The application performs deterministic rule-based extraction by default and
# does not require this. Set these only to enable the optional LLM-assisted path.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30

# --- Financial validation tolerance ---
VALIDATION_ABSOLUTE_TOLERANCE=1.0
VALIDATION_RELATIVE_TOLERANCE=0.01

# --- CORS ---
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
